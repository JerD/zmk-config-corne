#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/reset.h>

&led_strip {
    chain-length = <27>;
};

/ {
    behaviors {
        td_curl: td_curly_brace {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LS(LBKT)>, <&kp LS(RBKT)>;
        };
        td_sqbk: td_square_brace {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LBKT>, <&kp RBKT>;
        };
        td_brce: td_parenthisis {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LS(N9)>, <&kp LS(N0)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            bindings = <
    &kp ESC      &kp Q       &kp W   &kp E      &kp R       &kp T                           &kp Y   &kp U   &kp I   &kp O       &kp P       &kp BSPC
    &kp TAB      &kp A       &kp S   &kp D      &kp F       &kp G                           &kp H   &kp J   &kp K   &kp L       &kp SEMI    &kp SQT
    &kp LSHFT    &kp NUBS    &kp Z   &kp X      &kp C       &kp V                           &kp B   &kp N   &kp M   &kp COMMA   &kp DOT     &kp FSLH
                                     &kp LGUI   &kp LALT    &kp LCTRL           &lt 2 SPACE &mo 1   &kp RALT
            >;
        };

        lower_layer {
            display-name = "ACT";

            bindings = <
    &trans  &trans  &trans      &kp N7  &kp N8  &kp N9                      &trans  &kp HOME    &kp UP      &kp END     &trans  &kp DELETE
    &trans  &trans  &kp DOT     &kp N4  &kp N5  &kp N6                      &trans  &kp LEFT    &kp DOWN    &kp RIGHT   &trans  &kp RET
    &trans  &trans  &kp N0      &kp N1  &kp N2  &kp N3                      &trans  &kp PG_DN   &kp PG_UP   &trans      &trans  &trans
                                        &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

        raise_layer {
            display-name = "SYM";
            
            bindings = <
    &trans      &kp LS(FSLH) &kp LS(N2)     &kp EQUAL   &kp LS(N8)  &kp LS(NUHS)                        &kp RA(N4)  &kp LS(MINUS) &td_sqbk  &kp LS(NUBS) &td_brce   &trans
    &trans      &kp LS(N7)  &kp LS(EQUAL)   &kp LS(N4)  &kp FSLH    &kp GRAVE                           &kp NUHS    &trans      &trans      &trans      &trans      &trans
    &trans      &kp LS(N5)  &trans          &trans      &td_curl    &kp LS(N6)                          &kp NUBS    &kp LS(N1)  &kp MINUS   &trans      &trans      &trans
                                                        &trans      &trans      &trans      &trans      &trans      &trans
            >;
        };


        func_layer {
            display-name = "FNC";

            bindings = <
    &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6                              &kp F7      &kp F8      &kp F9      &kp F10     &kp F11     &kp F12
    &trans      &trans      &trans      &trans      &trans      &trans                              &trans      &trans      &trans      &trans      &trans      &trans
    &trans      &trans      &trans      &trans      &trans      &bootloader                         &bootloader &trans      &trans      &trans      &trans      &trans        
                                                    &trans      &trans      &trans      &trans      &trans      &trans
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };
    };
};
